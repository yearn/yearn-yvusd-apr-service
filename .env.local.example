# OpenTelemetry error reporting. Leave the endpoint unset to disable.
# Point at an OTLP/HTTP base endpoint (the exporter appends /v1/logs).
OTEL_EXPORTER_OTLP_ENDPOINT=
# For a signal-specific endpoint, including Sentry's complete .../v1/logs URL,
# use this instead. The exporter uses this value verbatim.
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# Example for Sentry: x-sentry-auth=sentry sentry_key=<your-key>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=yvusd-apr-service
